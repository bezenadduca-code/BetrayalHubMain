-- Function to BUY the LegacyMS100TwoTime skin
local function buyLegacyMS100Skin()
    if not dataHandlerModule or not networkModule then
        print("❌ Required modules not loaded")
        return false
    end
    
    print("🔍 Checking if LegacyMS100TwoTime is already owned...")
    
    -- Check if we already own it
    local purchased = dataHandlerModule:ReadPath("Purchased")
    if not purchased then
        print("❌ Purchased data not found")
        return false
    end
    
    local skinsFolder = purchased:FindFirstChild("Skins")
    if not skinsFolder then
        print("❌ Skins folder not found")
        return false
    end
    
    local survivorsFolder = skinsFolder:FindFirstChild("Survivors")
    if not survivorsFolder then
        print("❌ Survivors folder not found in Skins")
        return false
    end
    
    -- Check if TwoTime skin folder exists in purchased
    local twoTimeSkin = survivorsFolder:FindFirstChild("LegacyMS100TwoTime")
    
    if twoTimeSkin then
        print("✅ LegacyMS100TwoTime is already owned!")
        return true
    end
    
    print("🛒 LegacyMS100TwoTime not owned. Attempting to purchase...")
    
    -- Find the skin in Assets to purchase
    local assets = replicatedStorage:FindFirstChild("Assets")
    if assets then
        assets = assets:FindFirstChild("Skins")
        if assets then
            assets = assets:FindFirstChild("Survivors")
            if assets then
                assets = assets:FindFirstChild("TwoTime")
                if assets then
                    assets = assets:FindFirstChild("LegacyMS100TwoTime")
                end
            end
        end
    end
    
    if not assets then
        print("❌ Could not find LegacyMS100TwoTime in Assets")
        return false
    end
    
    -- Send purchase request to server
    local purchaseResult = networkModule:FireServerConnection("PurchaseContent", "REMOTE_FUNCTION", assets)
    
    if purchaseResult and purchaseResult.Status == "success" then
        print("✅ Successfully purchased LegacyMS100TwoTime skin!")
        skinPurchased = true
        return true
    else
        local errorMsg = purchaseResult and purchaseResult.Status or "unknown"
        print("❌ Purchase failed: " .. errorMsg)
        return false
    end
end

-- Function to EQUIP the LegacyMS100TwoTime skin (the whole folder)
local function equipLegacyMS100Skin()
    if not dataHandlerModule or not networkModule then
        print("❌ Required modules not loaded")
        return false
    end
    
    print("🔧 Equipping LegacyMS100TwoTime skin...")
    
    -- Find the skin in purchased data
    local purchased = dataHandlerModule:ReadPath("Purchased")
    if not purchased then
        print("❌ Purchased data not found")
        return false
    end
    
    local skinsFolder = purchased:FindFirstChild("Skins")
    if not skinsFolder then
        print("❌ Skins folder not found")
        return false
    end
    
    local survivorsFolder = skinsFolder:FindFirstChild("Survivors")
    if not survivorsFolder then
        print("❌ Survivors folder not found")
        return false
    end
    
    local twoTimeSkin = survivorsFolder:FindFirstChild("LegacyMS100TwoTime")
    if not twoTimeSkin then
        print("❌ LegacyMS100TwoTime not found in purchased data!")
        return false
    end
    
    -- Send equip request to server for the WHOLE skin folder
    local equipResult = networkModule:FireServerConnection("EquipState", "REMOTE_EVENT", twoTimeSkin, true)
    
    if equipResult then
        print("✅ LegacyMS100TwoTime equipped successfully!")
        return true
    else
        print("❌ Equip request failed")
        return false
    end
end

-- ============================================
-- VISUAL SKIN SYSTEM (Life1 / Life2)
-- ============================================

local function runSkinScript(forcedModelName)
    local character = player.Character
    if not character then 
        return false 
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then 
        return false 
    end

    -- Check game state
    local map = workspace:FindFirstChild("Map")
    if not map then return false end

    local ingame = map:FindFirstChild("Ingame")
    if not ingame then return false end

    local playersFolder = workspace:FindFirstChild("Players")
    if not playersFolder then return false end

    local survivors = playersFolder:FindFirstChild("Survivors")
    if not survivors then return false end

    if not character:IsDescendantOf(survivors) then 
        return false 
    end

    print("✅ Game checks passed! Applying visual skin...")

    -- Asset path for the skin model
    local legacyMS4 = replicatedStorage:FindFirstChild("Assets")
    if legacyMS4 then
        legacyMS4 = legacyMS4:FindFirstChild("Skins")
    end
    if legacyMS4 then
        legacyMS4 = legacyMS4:FindFirstChild("Survivors")
    end
    if legacyMS4 then
        legacyMS4 = legacyMS4:FindFirstChild("TwoTime")
    end
    if legacyMS4 then
        legacyMS4 = legacyMS4:FindFirstChild("LegacyMS100TwoTime")
    end
    
    if not legacyMS4 then
        print("❌ Could not find LegacyMS100TwoTime skin model")
        return true 
    end

    local config = legacyMS4:FindFirstChild("Config")
    if not config then
        print("❌ Config folder missing")
        return true
    end

    -- The model name inside Config (Life1 or Life2)
    local targetModel = config:FindFirstChild(forcedModelName)
    if not targetModel then
        print("❌ Model " .. forcedModelName .. " missing in Config")
        return true
    end

    print("🎯 Applying visual model: " .. targetModel.Name)

    -- Clear old stuff
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Clothing") or child:IsA("Shirt") or child:IsA("Pants") or child:IsA("Accessory") or child:IsA("Hat") or child:IsA("ShirtGraphic") then
            child:Destroy()
        elseif child:IsA("Model") and child.Name ~= "LegacyMS4_Attached" and child.Name ~= "Head" then
            child:Destroy()
        end
    end

    local old = character:FindFirstChild("LegacyMS4_Attached")
    if old then old:Destroy() end

    local folder = Instance.new("Folder")
    folder.Name = "LegacyMS4_Attached"
    folder.Parent = character

    local head = character:FindFirstChild("Head")
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    local leftArm = character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftUpperArm")
    local rightArm = character:FindFirstChild("Right Arm") or character:FindFirstChild("RightUpperArm")
    local leftLeg = character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftLowerLeg")
    local rightLeg = character:FindFirstChild("Right Leg") or character:FindFirstChild("RightUpperLeg")

    if head then
        head.Transparency = 0
        head.CanCollide = false
        head.CanQuery = false
        head.CanTouch = false
    end

    local modelPivot = targetModel:GetPivot()
    local attachedCount = 0

    for _, part in ipairs(targetModel:GetDescendants()) do
        if part:IsA("BasePart") then
            local partName = part.Name
            if string.find(partName, "Hitbox") or string.find(partName, "Collision") or string.find(partName, "Detector") or string.find(partName, "Query") or string.find(partName, "Holder") or string.find(partName, "HumanoidRootPart") or string.find(partName, "Root") or string.find(partName, "Weapon") or string.find(partName, "Blade") or string.find(partName, "Handle") then
                continue
            end

            local target = nil
            if partName == "hair" or partName == "halo" or partName == "hat" then
                target = head
            elseif partName == "Torso" or partName == "graphic" or partName == "belt" or partName == "scarf" or partName == "chest" or partName == "tail" or partName == "wings" or partName == "wing1" or partName == "wing2" then
                target = torso
            elseif string.find(partName, "Left") or string.find(partName, "left") then
                if string.find(partName, "Leg") then target = leftLeg
                elseif string.find(partName, "Arm") or string.find(partName, "Hand") or string.find(partName, "Glove") or string.find(partName, "Bandage") then target = leftArm
                else target = torso end
            elseif string.find(partName, "Right") or string.find(partName, "right") then
                if string.find(partName, "Leg") then target = rightLeg
                elseif string.find(partName, "Arm") or string.find(partName, "Hand") or string.find(partName, "Glove") or string.find(partName, "Bandage") then target = rightArm
                else target = torso end
            else
                target = torso
            end

            if target then
                local newPart = part:Clone()
                newPart.Size = part.Size
                newPart.Transparency = part.Transparency or 0
                newPart.Color = part.Color or Color3.new(1, 1, 1)
                newPart.Material = part.Material or Enum.Material.SmoothPlastic
                newPart.Anchored = false
                newPart.CanCollide = false
                newPart.CanQuery = false
                newPart.CanTouch = false
                newPart.Massless = true

                local templateTargetPart = targetModel:FindFirstChild(target.Name, true)
                if templateTargetPart and templateTargetPart:IsA("BasePart") then
                    local offset = templateTargetPart.CFrame:ToObjectSpace(part.CFrame)
                    newPart.CFrame = target.CFrame * offset
                else
                    local relativeCFrame = modelPivot:ToObjectSpace(part.CFrame)
                    newPart.CFrame = target.CFrame * relativeCFrame
                end

                newPart.Parent = folder

                local weld = Instance.new("Weld")
                weld.Part0 = target
                weld.Part1 = newPart
                weld.C0 = target.CFrame:ToObjectSpace(newPart.CFrame)
                weld.Parent = newPart

                attachedCount = attachedCount + 1
            end
        end
    end

    print("✅ Attached " .. attachedCount .. " visual parts from " .. targetModel.Name)
    skinApplied = true
    return true
end

-- ============================================
-- MAIN LOGIC: BUY + EQUIP (LegacyMS100TwoTime) + VISUAL (Life1/Life2)
-- ============================================

-- Function to handle buying, equipping, and visual skin
local function applySkin(modelName)
    -- modelName = "Life1" or "Life2" (for visual only)
    
    -- Step 1: Buy the LegacyMS100TwoTime skin if not owned
    if not skinPurchased then
        local buySuccess = buyLegacyMS100Skin()
        if buySuccess then
            skinPurchased = true
            print("✅ LegacyMS100TwoTime purchased!")
        else
            print("⚠️ Failed to purchase skin, but continuing...")
        end
    end
    
    -- Step 2: Equip the LegacyMS100TwoTime skin (the whole thing)
    local equipSuccess = equipLegacyMS100Skin()
    
    if equipSuccess then
        print("✅ LegacyMS100TwoTime equipped in inventory!")
    else
        print("⚠️ Failed to equip LegacyMS100TwoTime, but continuing with visual...")
    end
    
    -- Step 3: Apply visual skin (Life1 or Life2)
    return runSkinScript(modelName)
end

