local function espClear()
    for obj, data in pairs(esp.tracked) do
        pcall(function() if data.highlight then data.highlight:Destroy() end end)
        pcall(function() if data.billboard then data.billboard:Destroy() end end)
    end
    esp.tracked = {}
    for _, c in ipairs(esp.childConns) do pcall(function() c:Disconnect() end) end
    esp.childConns = {}
end

local function espClearCategory(category)
    for obj, data in pairs(esp.tracked) do
        if data.category == category then
            pcall(function() if data.highlight then data.highlight:Destroy() end end)
            pcall(function() if data.billboard then data.billboard:Destroy() end end)
            esp.tracked[obj] = nil
        end
    end
end

local function espGetTeamFolder(name)
    local root = WS:FindFirstChild("Players")
    return root and root:FindFirstChild(name)
end

local function espGetMapContent()
    local m = WS:FindFirstChild("Map")
    local ig = m and m:FindFirstChild("Ingame")
    return ig and ig:FindFirstChild("Map")
end

local function espAdd(obj, color, labelText, category)
    if not obj or not obj.Parent or esp.tracked[obj] then return end
    local attach = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChildWhichIsA("BasePart")
    if not attach then return end

    local hl = Instance.new("Highlight")
    hl.Name = "BetrayalESP_HL"
    hl.FillColor = color
    hl.FillTransparency = esp.transparency
    hl.OutlineColor = color
    hl.OutlineTransparency = 0.1
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = obj
    hl.Parent = obj

    local bb = Instance.new("BillboardGui")
    bb.Name = "BetrayalESP_BB"
    bb.Adornee = attach
    bb.Size = UDim2.new(0, 140, 0, 20)
    bb.StudsOffset = Vector3.new(0, 4, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = esp.maxDistance
    bb.Parent = obj

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText or obj.Name
    label.TextColor3 = color
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.TextStrokeTransparency = 0.3
    label.TextSize = 10
    label.Font = Enum.Font.GothamBold
    label.Parent = bb

    esp.tracked[obj] = {
        highlight = hl,
        billboard = bb,
        label = label,
        baseName = labelText or obj.Name,
        category = category or "misc",
        color = color,
    }

    table.insert(esp.childConns, obj.AncestryChanged:Connect(function(_, parent)
        if not parent and esp.tracked[obj] then
            local d = esp.tracked[obj]
            pcall(function() d.highlight:Destroy() end)
            pcall(function() d.billboard:Destroy() end)
            esp.tracked[obj] = nil
        end
    end))
end

local function espScanTeams()
    local myChar = LP.Character

    if esp.showKillers then
        local kf = espGetTeamFolder("Killers")
        if kf then
            for _, m in ipairs(kf:GetChildren()) do
                if m:IsA("Model") and m ~= myChar then
                    local h = m:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 then espAdd(m, COLORS.Killer, m.Name, "killer") end
                end
            end
        end
    end

    if esp.showSurvivors then
        local sf = espGetTeamFolder("Survivors")
        if sf then
            for _, m in ipairs(sf:GetChildren()) do
                if m:IsA("Model") and m ~= myChar then
                    local h = m:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 then espAdd(m, COLORS.Survivor, m.Name, "survivor") end
                end
            end
        end
    end

    if esp.showGenerators then
        local mc = espGetMapContent()
        if mc then
            for _, o in ipairs(mc:GetChildren()) do
                if o.Name == "Generator" and o.Parent then
                    espAdd(o, COLORS.Generator, "Generator", "generator")
                end
            end
        end
    end
end

local function espRefreshAll()
    for obj, data in pairs(esp.tracked) do
        if obj.Parent then
            if data.highlight then data.highlight.FillTransparency = esp.transparency end
            if data.billboard then data.billboard.MaxDistance = esp.maxDistance end
        end
    end
    if not esp.showKillers    then espClearCategory("killer")    end
    if not esp.showSurvivors  then espClearCategory("survivor")  end
    if not esp.showGenerators then espClearCategory("generator") end
    pcall(espScanTeams)
end

local function espStart()
    esp.enabled = true
    if esp.thread then task.cancel(esp.thread) end
    esp.thread = task.spawn(function()
        while esp.enabled do
            pcall(espScanTeams)
            local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if myHRP then
                for obj, data in pairs(esp.tracked) do
                    if obj and obj.Parent and data.label then
                        local a = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
                        if a then
                            local dist = (a.Position - myHRP.Position).Magnitude
                            if data.highlight then data.highlight.Enabled = dist <= esp.maxDistance end
                            if data.billboard then data.billboard.Enabled = dist <= esp.maxDistance end
                            data.label.Text = string.format("%s [%d]", data.baseName, math.floor(dist))
                        end
                    end
                end
            end
            task.wait(0.2)
        end
    end)
end

local function espStop()
    esp.enabled = false
    if esp.thread then task.cancel(esp.thread); esp.thread = nil end
    espClear()
end

