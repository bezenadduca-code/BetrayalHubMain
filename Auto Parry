local runSpeed = { enabled = false, speed = 30, lastValue = 0, thread = nil }
local _sprintMod, _sprintOrigInit

local function getSprintModule()
    if _sprintMod then return _sprintMod end
    local ok, m = pcall(function() return require(RS.Systems.Character.Game.Sprinting) end)
    if ok and m then _sprintMod = m; _sprintOrigInit = m.Init end
    return ok and m or nil
end

local function applyRunSpeed()
    pcall(function()
        if not runSpeed.enabled then return end
        local m = getSprintModule(); if not m then return end
        if not m.DefaultsSet then pcall(function() m.Init() end) end
        if runSpeed.speed ~= runSpeed.lastValue then
            m.SprintSpeed = runSpeed.speed
            pcall(function() m.MaxSprintSpeed = runSpeed.speed end)
            runSpeed.lastValue = runSpeed.speed
        end
    end)
end

local function startRunSpeed()
    if runSpeed.thread then return end
    runSpeed.thread = task.spawn(function()
        while runSpeed.enabled do
            pcall(function()
                if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then applyRunSpeed() end
            end)
            task.wait(0.2)
        end
        runSpeed.thread = nil
    end)
end

local function stopRunSpeed()
    runSpeed.enabled = false
    if runSpeed.thread then task.cancel(runSpeed.thread); runSpeed.thread = nil end
    pcall(function()
        local m = getSprintModule()
        if m then m.SprintSpeed = 26; pcall(function() m.MaxSprintSpeed = 26 end) end
    end)
end

