local function fireParrySignal()
    local success = pcall(function()
        local button = getParryButton()
        if not button then
            if CONFIG.debug then warn("[AutoParry] Parry button not found") end
            return
        end
        button.Active = true
        button.Visible = true
        pcall(function() button.Interactable = true end)
        if not firesignal then return end
        pcall(function() firesignal(button.Activated) end)
        pcall(function() firesignal(button.MouseButton1Click) end)
    end)
    if CONFIG.debug then print("[AutoParry] Fired Parry signals — ok:", success) end
    return success
end

