local function buildEmoteGui()
    if state.sg and state.sg.Parent then return end

    local PGui = LocalPlayer:WaitForChild("PlayerGui")
    local old = PGui:FindFirstChild("LocalEmoteGUI")
    if old then old:Destroy() end

    local SG = Instance.new("ScreenGui")
    SG.Name = "LocalEmoteGUI"
    SG.ResetOnSpawn = false
    SG.IgnoreGuiInset = true
    SG.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    SG.Parent = PGui
    state.sg = SG

    local function rnd(i, r)
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, r or 8)
        c.Parent = i
    end

    local function tw(o, t, p)
        TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), p):Play()
    end

    -- Toggle button
    local Tog = Instance.new("TextButton")
    Tog.Size = UDim2.new(0, 50, 0, 50)
    Tog.Position = UDim2.new(1, -70, 1, -70)
    Tog.Text = "🎵"
    Tog.TextSize = 24
    Tog.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    Tog.AutoButtonColor = false
    Tog.BorderSizePixel = 0
    Tog.ZIndex = 20
    Tog.Parent = SG
    rnd(Tog, 25)

    local togDragging, togDragStart, togStartPos, togMoved = false, nil, nil, false
    Tog.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            togDragging = true
            togMoved = false
            togDragStart = inp.Position
            togStartPos  = Tog.Position
            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then
                    togDragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if togDragging
        and (inp.UserInputType == Enum.UserInputType.MouseMovement
             or inp.UserInputType == Enum.UserInputType.Touch) then
            local d = inp.Position - togDragStart
            if d.Magnitude > 4 then togMoved = true end
            Tog.Position = UDim2.new(
                togStartPos.X.Scale, togStartPos.X.Offset + d.X,
                togStartPos.Y.Scale, togStartPos.Y.Offset + d.Y
            )
        end
    end)

    local PW, PH = 220, 340
    local Panel = Instance.new("Frame")
