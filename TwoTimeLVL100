-- Handle character spawn/respawn
player.CharacterAdded:Connect(function(char)
    task.wait(1) -- Wait for character to fully load
    
    local character = player.Character
    if not character then return end
    
    -- Check if player is at their respawn location
    if respawnPart and isAtRespawn(character) then
        print("🔴 " .. localPlayerName .. " spawned at their respawn location!")
        print("📍 Position: " .. tostring(character.HumanoidRootPart.Position))
        
        -- If they already used Life1, apply Life2
        if hasUsedLife2 then
            print("🔄 Applying Life2 (second life)...")
            applySkin()
            changeTwoTimeIcon()
        else
            print("🔄 Applying Life1 (first life)...")
            hasUsedLife2 = true
            applySkin()
        end
    else
        -- Normal spawn, apply Life1
        if not hasUsedLife2 then
            print("🔄 Applying Life1 (first life)...")
            hasUsedLife2 = true
            applySkin()
        end
    end
end)

