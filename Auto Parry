local function isInRange(killerHRP, myHRP)
    if not killerHRP or not myHRP then return false end
    local toMe = myHRP.Position - killerHRP.Position
    toMe = Vector3.new(toMe.X, 0, toMe.Z)
    return toMe.Magnitude <= CONFIG.detectionRange
end

local function createVisual()
    local container = Instance.new("Folder"); container.Name = "AutoParryVisual"
    local disc = Instance.new("Part")
    disc.Name = "Disc"; disc.Shape = Enum.PartType.Cylinder
    disc.Size = Vector3.new(0.05, 60, 60); disc.Anchored = true
    disc.CanCollide = false; disc.CanQuery = false; disc.CanTouch = false
    disc.Material = Enum.Material.ForceField; disc.Transparency = 0.85
    disc.Color = CONFIG.colorOut; disc.Parent = container

    local outline = Instance.new("Part")
    outline.Name = "Outline"; outline.Shape = Enum.PartType.Cylinder
    outline.Size = Vector3.new(0.02, 60, 60); outline.Anchored = true
    outline.CanCollide = false; outline.CanQuery = false; outline.CanTouch = false
    outline.Material = Enum.Material.Neon; outline.Transparency = 0.3
    outline.Color = CONFIG.colorOut; outline.Parent = container

    container.Parent = WS
    return { container = container, disc = disc, outline = outline }
end

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.IgnoreWater = true

local function getGroundUnderKiller(killer)
    if not killer or not killer.Parent then return nil end
    local killerHRP = killer:FindFirstChild("HumanoidRootPart"); if not killerHRP then return nil end
    raycastParams.FilterDescendantsInstances = { killer, LP.Character }
    local result = WS:Raycast(killerHRP.Position, Vector3.new(0, -50, 0), raycastParams)
    if result then return result.Position end
    return Vector3.new(killerHRP.Position.X, killerHRP.Position.Y - 3, killerHRP.Position.Z)
end

local function updateVisual(killer, vis)
    if not killer or not killer.Parent then return end
    local killerHRP = killer:FindFirstChild("HumanoidRootPart"); if not killerHRP then return end
    local ch = LP.Character
    local myHRP = ch and ch:FindFirstChild("HumanoidRootPart")
    if not myHRP then vis.disc.Transparency = 1; vis.outline.Transparency = 1; return end

    local inRange = isInRange(killerHRP, myHRP)
    local color = inRange and CONFIG.colorIn or CONFIG.colorOut
    vis.disc.Color = color; vis.outline.Color = color

    local groundPos = getGroundUnderKiller(killer); if not groundPos then return end
    local diam = CONFIG.detectionRange * 2

    vis.disc.Size = Vector3.new(0.05, diam, diam)
    vis.disc.CFrame = CFrame.new(groundPos + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90))
    vis.disc.Transparency = inRange and 0.75 or 0.85

    vis.outline.Size = Vector3.new(0.02, diam, diam)
    vis.outline.CFrame = CFrame.new(groundPos + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, 0, math.rad(90))
    vis.outline.Transparency = inRange and 0.3 or 0.5
end

local function cleanupVisuals()
    for _, vis in pairs(state.rangeParts) do pcall(function() vis.container:Destroy() end) end
    state.rangeParts = {}
end

local function findActiveKillers()
    local found = {}
    local paths = { WS:FindFirstChild("Players"), WS:FindFirstChild("Live"), WS:FindFirstChild("Entities"), WS }
    for _, container in ipairs(paths) do
        if container then
            local subKillers = container:FindFirstChild("Killers")
            local targets = subKillers and subKillers:GetChildren() or container:GetChildren()
            for _, obj in ipairs(targets) do
                if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 and obj ~= LP.Character then found[obj] = true end
                end
            end
        end
    end
    return found
end

local function startRangeLoop()
    if state.rangeThread then return end
    state.rangeThread = task.spawn(function()
        while CONFIG.showRange do
            local seen = findActiveKillers()
            for killer, _ in pairs(seen) do
                if not state.rangeParts[killer] then state.rangeParts[killer] = createVisual() end
                updateVisual(killer, state.rangeParts[killer])
            end
            for killer, vis in pairs(state.rangeParts) do
                if not seen[killer] then
                    pcall(function() vis.container:Destroy() end)
                    state.rangeParts[killer] = nil
                end
            end
            task.wait(0.03)
        end
        state.rangeThread = nil
    end)
end

