local function antiBaitEnsureLine(killer)
    local khrp = killer:FindFirstChild("HumanoidRootPart")
    if not khrp then return nil end

    local entry = antiBaitLines[killer]
    if entry and entry.beam and entry.beam.Parent then
        if entry.a1 then entry.a1.Position = Vector3.new(0, 0, -CONFIG.antiBaitLength) end
        return entry
    end

    local a0 = Instance.new("Attachment")
    a0.Name = "AntiBait_A0"
    a0.Position = Vector3.zero
    a0.Parent = khrp

    local a1 = Instance.new("Attachment")
    a1.Name = "AntiBait_A1"
    a1.Position = Vector3.new(0, 0, -CONFIG.antiBaitLength)
    a1.Parent = khrp

    local beam = Instance.new("Beam")
    beam.Name = "AntiBait_Beam"
    beam.Attachment0 = a0
    beam.Attachment1 = a1
    beam.Width0 = 0.15
    beam.Width1 = 0.15
    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.LightInfluence = 0
    beam.Transparency = NumberSequence.new(0.2)
    beam.Color = ColorSequence.new(Color3.fromRGB(80, 80, 220))
    beam.Segments = 1
    beam.Parent = khrp

    local corridor = Instance.new("Part")
    corridor.Name = "AntiBait_Corridor"
    corridor.Size = Vector3.new(CONFIG.antiBaitWidth, 6, CONFIG.antiBaitLength)
    corridor.Anchored = true
    corridor.CanCollide = false
    corridor.CanQuery = false
    corridor.CanTouch = false
    corridor.Transparency = 1
    corridor.Massless = true
    corridor.Parent = WS

    antiBaitLines[killer] = { beam = beam, a0 = a0, a1 = a1, corridor = corridor }
    return antiBaitLines[killer]
end

local function antiBaitRemoveLine(killer)
    local entry = antiBaitLines[killer]
    if not entry then return end
    pcall(function() if entry.beam then entry.beam:Destroy() end end)
    pcall(function() if entry.a0 then entry.a0:Destroy() end end)
    pcall(function() if entry.a1 then entry.a1:Destroy() end end)
    pcall(function() if entry.corridor then entry.corridor:Destroy() end end)
    antiBaitLines[killer] = nil
end

local function antiBaitUpdateLines()
    local active = findActiveKillers()
    for killer in pairs(antiBaitLines) do
        if not active[killer] then antiBaitRemoveLine(killer) end
    end
    if not CONFIG.antiBaitShowLine then
        for killer in pairs(antiBaitLines) do antiBaitRemoveLine(killer) end
        return
    end
    for killer in pairs(active) do
        local entry = antiBaitEnsureLine(killer)
        if entry then
            local khrp = killer:FindFirstChild("HumanoidRootPart")
            if khrp and entry.corridor then
                if entry.a1 then entry.a1.Position = Vector3.new(0, 0, -CONFIG.antiBaitLength) end

                local cf = CFrame.new(khrp.Position + Vector3.new(0, 1, 0), khrp.Position + Vector3.new(0, 1, 0) + khrp.CFrame.LookVector)
                entry.corridor.Size = Vector3.new(CONFIG.antiBaitWidth, 6, CONFIG.antiBaitLength)
                entry.corridor.CFrame = cf * CFrame.new(0, 0, -CONFIG.antiBaitLength / 2)

                local myChar = LP.Character
                local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myHRP then
                    local inside = false
                    pcall(function()
                        local rel = entry.corridor.CFrame:PointToObjectSpace(myHRP.Position)
                        local half = entry.corridor.Size * 0.5
                        inside = math.abs(rel.X) <= half.X
                             and math.abs(rel.Y) <= half.Y
                             and math.abs(rel.Z) <= half.Z
                    end)
                    local c = inside and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(80, 80, 220)
                    entry.beam.Color = ColorSequence.new(c)
                end
            end
        end
    end
end

local function antiBaitStartLoop()
    if antiBaitThread then return end
    antiBaitThread = task.spawn(function()
        while state.enabled or CONFIG.antiBaitShowLine do
            pcall(antiBaitUpdateLines)
            task.wait(0.05)
        end
        antiBaitThread = nil
    end)
end

local function antiBaitStopLoop()
    if antiBaitThread then task.cancel(antiBaitThread); antiBaitThread = nil end
    for killer in pairs(antiBaitLines) do antiBaitRemoveLine(killer) end
end

local function isInsideAntiBaitLine(killer, myHRP)
    if not CONFIG.antiBait then return true end
    if not killer or not myHRP then return false end

    local khrp = killer:FindFirstChild("HumanoidRootPart")
    if not khrp then return false end

    local forward = khrp.CFrame.LookVector * Vector3.new(1, 0, 1)
    if forward.Magnitude < 0.01 then return false end
    forward = forward.Unit

    local toMe = (myHRP.Position - khrp.Position) * Vector3.new(1, 0, 1)
    local alongDist = toMe:Dot(forward)
    local lateral   = (toMe - forward * alongDist).Magnitude

    local halfWidth = CONFIG.antiBaitWidth * 0.5 + CONFIG.antiBaitForgive

    return alongDist >= 0
       and alongDist <= CONFIG.antiBaitLength
       and lateral    <= halfWidth
end

-- ============================================================
-- KILLER HOOKS
-- ============================================================
local function hookKiller(killer)
    if not killer:IsA("Model") then return end
    local hum = killer:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        task.spawn(function()
            local a = hum:WaitForChild("Animator", 5)
            if a then hookKiller(killer) end
        end)
        return
    end
    if killer:GetAttribute("AutoParryHooked") then return end
    killer:SetAttribute("AutoParryHooked", true)

    local conn = animator.AnimationPlayed:Connect(function(track)
        if not state.enabled then return end
        if not hum or hum.Health <= 0 then return end
        local animId = ""
        pcall(function() if track and track.Animation then animId = tostring(track.Animation.AnimationId or "") end end)
        if animId == "" then return end
        local num = animId:match("(%d+)")
        if not num then return end
        local killerName = KILLER_M1[num]
        if not killerName then return end
        if not killer.Parent then return end

        local ch = LP.Character; if not ch then return end
        local myHRP = ch:FindFirstChild("HumanoidRootPart"); if not myHRP then return end
        local killerHRP = killer:FindFirstChild("HumanoidRootPart"); if not killerHRP then return end

        if not isInRange(killerHRP, myHRP) then
            if CONFIG.debug then
                print(string.format("[AutoParry] %s animation out of range (%.1f studs)",
                    killerName, (myHRP.Position - killerHRP.Position).Magnitude))
            end
            return
        end

        if not isInsideAntiBaitLine(killer, myHRP) then
            if CONFIG.debug then
                print(string.format("[AutoParry] %s anim BAITED — not in line, skipping", killerName))
            end
            return
        end

        if tick() - state.lastParryTime < CONFIG.parryCooldown then return end

        state.lastParryTime = tick()
        if CONFIG.debug then
            print(string.format("[AutoParry] 🔥 %s M1 confirmed (in line) — firing Parry!", killerName))
        end
        fireParrySignal()
    end)
    table.insert(state.animatorConns, conn)
end

local function setupKillerWatchers()
    for _, c in ipairs(state.animatorConns) do pcall(function() c:Disconnect() end) end
    state.animatorConns = {}
    for _, c in ipairs(state.killerConns) do pcall(function() c:Disconnect() end) end
    state.killerConns = {}

    local active = findActiveKillers()
    local count = 0
    for killer, _ in pairs(active) do hookKiller(killer); count = count + 1 end

    table.insert(state.killerConns, WS.ChildAdded:Connect(function(c)
        task.wait(0.3)
        if c:IsA("Model") and c:FindFirstChild("HumanoidRootPart") then hookKiller(c) end
    end))
    print("[AutoParry] Hooked " .. count .. " workspace killers")
end

