                end

                row.MouseEnter:Connect(function()
                    tw(row, 0.08, { BackgroundColor3 = Color3.fromRGB(38, 38, 56) })
                end)
                row.MouseLeave:Connect(function()
                    tw(row, 0.08, { BackgroundColor3 = Color3.fromRGB(22, 22, 32) })
                end)
                row.MouseButton1Down:Connect(function()
                    tw(row, 0.05, { BackgroundColor3 = Color3.fromRGB(50, 80, 160) })
                end)
                row.MouseButton1Click:Connect(function() emPlay(ch) end)

                table.insert(rows, row)
            end
        end

        if n == 0 then
            local e = Instance.new("TextLabel")
            e.Size = UDim2.new(1, 0, 0, 28)
            e.Text = "None found"
            e.TextColor3 = Color3.fromRGB(90, 90, 110)
            e.TextSize = 11
            e.Font = Enum.Font.Gotham
            e.BackgroundTransparency = 1
            e.TextXAlignment = Enum.TextXAlignment.Center
            e.Parent = Scrl
            table.insert(rows, e)
        end
    end

    Srch:GetPropertyChangedSignal("Text"):Connect(function()
        refreshList(Srch.Text)
    end)

    local pOpen = false
    local function setPanel(open)
        pOpen = open
        Tog.Text = open and "✕" or "🎵"
        Panel.Visible = open
        if open then refreshList(Srch.Text) end
    end

    Tog.MouseButton1Click:Connect(function()
        if not togMoved then setPanel(not pOpen) end
        togMoved = false
    end)
    CX.MouseButton1Click:Connect(function() setPanel(false) end)

    refreshList("")
end

-- ============================================================
-- BUILD STOP GUI (separate, bottom-left)
-- ============================================================
local function buildStopGui()
    if state.stopGui and state.stopGui.Parent then return end

    local PGui = LocalPlayer:WaitForChild("PlayerGui")
    local old = PGui:FindFirstChild("LocalEmoteStopGUI")
    if old then old:Destroy() end

    local SG = Instance.new("ScreenGui")
    SG.Name = "LocalEmoteStopGUI"
    SG.ResetOnSpawn = false
    SG.IgnoreGuiInset = true
    SG.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    SG.Parent = PGui
    state.stopGui = SG

    local function rnd(i, r)
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, r or 8)
        c.Parent = i
    end

    local function tw(o, t, p)
        TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), p):Play()
    end

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 130, 0, 40)
    Btn.Position = UDim2.new(0, 20, 1, -60)
    Btn.Text = "■  Stop Emote"
    Btn.TextSize = 13
    Btn.Font = Enum.Font.GothamBold
    Btn.TextColor3 = Color3.fromRGB(255, 100, 100)
    Btn.BackgroundColor3 = Color3.fromRGB(22, 14, 14)
    Btn.AutoButtonColor = false
    Btn.BorderSizePixel = 0
    Btn.ZIndex = 20
    Btn.Parent = SG
    rnd(Btn, 8)

    Btn.MouseEnter:Connect(function()
        tw(Btn, 0.1, { BackgroundColor3 = Color3.fromRGB(40, 16, 16) })
    end)
    Btn.MouseLeave:Connect(function()
        tw(Btn, 0.1, { BackgroundColor3 = Color3.fromRGB(22, 14, 14) })
    end)
    Btn.MouseButton1Click:Connect(function() emStop() end)

    local dragging, dragStart, startPos = false, nil, nil
    Btn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = inp.Position
            startPos  = Btn.Position
            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging
        and (inp.UserInputType == Enum.UserInputType.MouseMovement
             or inp.UserInputType == Enum.UserInputType.Touch) then
            local d = inp.Position - dragStart
            Btn.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
end

