-- ============================================================
-- STOP EMOTE
-- ============================================================
local function emStop()
    if not state.emoting then return end
    state.emoting = false

    if state.rotConn then state.rotConn:Disconnect(); state.rotConn = nil end

    local ch = LocalPlayer.Character
    if ch then
        local root = ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
        local hum  = ch:FindFirstChildOfClass("Humanoid")

        local localModel = ch:FindFirstChild("LocalEmoteModel")
        if localModel then localModel:Destroy() end

        for _, m in ipairs(ch:GetChildren()) do
            if m:IsA("Model") and m:FindFirstChild("FakeTorso") then
                m:Destroy()
            end
        end

        if root then
            local att = root:FindFirstChild("LocalEmoteAtt")
            if att then att:Destroy() end
            root.Anchored = false
        end

        local vfx = ch:FindFirstChild("LocalEmoteVFX")
        if vfx then vfx:Destroy() end

        if hum then
            hum.WalkSpeed = state.spd
            hum.JumpPower = state.jump
        end
    end

    local snd = SoundService:FindFirstChild("LocalEmoteSound")
    if snd then snd:Destroy() end

    if state.track then
        pcall(function() state.track:Stop() end)
        state.track = nil
    end

    state.sound      = nil
    state.particles  = nil
    state.attachment = nil
    state.heldModel  = nil
    state.currentMod = nil
end

-- ============================================================
-- PLAY EMOTE
-- ============================================================
local function emPlay(mod)
    if state.emoting then emStop(); task.wait(0.1) end

    local ch = LocalPlayer.Character
    if not ch then return end

    local hum  = ch:FindFirstChildOfClass("Humanoid")
    local root = ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
    local anim = hum and hum:WaitForChild("Animator", 2)
    if not hum or not root or not anim then return end

    -- Try BindableFunction first (our generated module), else require()
    local data
    local provider = mod:FindFirstChild("GetData")
    if provider and provider:IsA("BindableFunction") then
        local ok, res = pcall(function() return provider:Invoke() end)
        if ok and type(res) == "table" then data = res end
    end
    if not data then
        local ok, res = pcall(require, mod)
        if ok and type(res) == "table" then data = res end
    end
    if not data or not data.AssetID then
        warn("[LocalEmote] Invalid emote data for: " .. mod.Name)
        return
    end

    state.emoting    = true
    state.currentMod = mod
    state.spd        = hum.WalkSpeed
    state.jump       = hum.JumpPower

    hum.WalkSpeed = 0
    hum.JumpPower = 0
    root.Anchored = true

    -- ---- animation ----
    local an = Instance.new("Animation")
    an.AnimationId = tostring(data.AssetID)
    local track = anim:LoadAnimation(an)
    track.Looped = true
    track:Play()
    state.track = track

    -- ---- face camera in first person ----
    if state.rotConn then state.rotConn:Disconnect() end
    state.rotConn = RunService.RenderStepped:Connect(function()
        if not state.emoting then return end
        local cam = workspace.CurrentCamera
        if not cam or cam.CameraType ~= Enum.CameraType.Custom then return end
        local ch2 = LocalPlayer.Character
        if not ch2 then return end
        local r2 = ch2:FindFirstChild("HumanoidRootPart")
        if not r2 then return end
        if LocalPlayer.CameraMode ~= Enum.CameraMode.LockFirstPerson then return end
        local _, camY, _ = cam.CFrame:ToEulerAnglesYXZ()
        r2.CFrame = CFrame.new(r2.Position) * CFrame.Angles(0, camY, 0)
    end)

    -- ---- sound ----
    if data.SFX then
        local oldSnd = SoundService:FindFirstChild("LocalEmoteSound")
        if oldSnd then oldSnd:Destroy() end

        local snd = Instance.new("Sound")
        snd.Name = "LocalEmoteSound"
        snd.SoundId = tostring(data.SFX)
        snd.Volume = 1
        snd.Looped = true
        snd.RollOffMode = Enum.RollOffMode.Inverse
        snd.RollOffMaxDistance = 60
        snd.RollOffMinDistance = 10
        snd.Parent = SoundService
        snd:Play()
        state.sound = snd
    end

    -- ---- held model (Cat) ----
    local function applyLocalCat()
        local alreadySpawned = false
        for _, c in ipairs(ch:GetChildren()) do
            if c:IsA("Model") and c:FindFirstChild("FakeTorso") then
                alreadySpawned = true; break
            end
        end

        if not alreadySpawned then
            local catModel = mod:FindFirstChild("Cat")
            if catModel and catModel:IsA("Model") then
                local clone = catModel:Clone()
                clone.Name = "LocalEmoteModel"

                local catWeld   = clone:FindFirstChild("CatWELD")
                local fakeTorso = clone:FindFirstChild("FakeTorso")
                local hand = ch:FindFirstChild("RightHand")
                    or ch:FindFirstChild("Right Arm")
                    or ch:FindFirstChild("RightLowerArm")
                    or root

                if catWeld and catWeld:IsA("Motor6D") then
                    catWeld.Part0 = hand
                    catWeld.Part1 = fakeTorso or catWeld.Part1
                    catWeld.C0 = data.WeldOffset or CFrame.new(0, -0.5, -0.5)
                    catWeld.C1 = CFrame.new()
                end

                for _, d in ipairs(clone:GetDescendants()) do
                    if d:IsA("BasePart") then
                        d.Anchored   = false
                        d.CanCollide = false
                        d.Massless   = true
                    end
                end

                if clone.PrimaryPart then
                    clone:PivotTo(hand.CFrame)
                end

                clone.Parent = ch
            end
        end
    end

    applyLocalCat()

    -- ---- particles ----
    local att = Instance.new("Attachment")
    att.Name = "LocalEmoteAtt"
    att.Parent = root

    local burst = Instance.new("ParticleEmitter")
    burst.Name = "LocalEmoteBurst"
    burst.Texture = "rbxassetid://635533604"
    burst.Rate = 60
    burst.Speed = NumberRange.new(2, 5)
    burst.Lifetime = NumberRange.new(0.5, 1.2)
    burst.Drag = 5
    burst.Parent = att

    state.attachment = att
    state.particles  = burst
end

