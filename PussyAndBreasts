local Players = game:GetService("Players")
local player = Players.LocalPlayer

local REF_CFRAME = CFrame.new(291.30010986328125, 358.79998779296875, 480.74969482421875, 0.9999034404754639, -0, -0.013897508382797241, 0, 1, -0, 0.013897508382797241, 0, 0.9999034404754639)

local function getRelativeCFrame(worldCFrame)
    return REF_CFRAME:ToObjectSpace(worldCFrame)
end

-- Get the player's actual skin color from their character
local function getSkinColor(char)
    -- Try body parts first (R15 then R6)
    local bodyParts = {
        char:FindFirstChild("UpperTorso"),
        char:FindFirstChild("LowerTorso"),
        char:FindFirstChild("Torso"),
        char:FindFirstChild("LeftUpperArm"),
        char:FindFirstChild("RightUpperArm"),
        char:FindFirstChild("Head"),
    }
    for _, part in ipairs(bodyParts) do
        if part and part:IsA("BasePart") then
            -- BodyColors-based color via BrickColor or Color
            local bc = char:FindFirstChildOfClass("BodyColors")
            if bc then
                local torsoColor = bc.TorsoColor3
                if torsoColor then
                    return torsoColor
                end
            end
            return part.Color
        end
    end
    return Color3.fromRGB(234, 184, 146) -- fallback
end

local function ApplyBoba()
    local char = player.Character
    if not char then return end
    
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not torso then return end
    
    -- Clean up old folder if it exists
    if char:FindFirstChild("CustomBoba") then
        char.CustomBoba:Destroy()
    end
    
    local folder = Instance.new("Folder")
    folder.Name = "CustomBoba"
    folder.Parent = char
    
    local skinColor = getSkinColor(char)
    
    local originalSize = Vector3.new(2.04, 2.06, 1.06)
    local scaleX = torso.Size.X / originalSize.X
    local scaleY = torso.Size.Y / originalSize.Y
    local scaleZ = torso.Size.Z / originalSize.Z
    
    -- === BREAST CFrames ===
    local leftSkinWorld = CFrame.new(290.755859375, 358.8601379394531, 480.14642333984375, -0.9096437692642212, -0.23451340198516846, 0.34285831451416016, 0.39973461627960205, -0.7186571359634399, 0.5689854025840759, 0.11296283453702927, 0.6546263098716736, 0.7474648952484131)
    local leftNippleWorld = CFrame.new(290.6434020996094, 358.90264892578125, 479.4735412597656, -0.7743892669677734, -0.6319825649261475, 0.03032258152961731, 0.6120918989181519, -0.7604285478591919, -0.21700669825077057, 0.16020260751247406, -0.1494874209165573, 0.9756990671157837)
    local rightSkinWorld = CFrame.new(291.8045654296875, 358.88104248046875, 480.16949462890625, -0.9152247905731201, -0.273607075214386, -0.29581037163734436, 0.055925317108631134, -0.8132690191268921, 0.5791949033737183, -0.39904507994651794, 0.5135499238967896, 0.7596246600151062)
    local rightNippleWorld = CFrame.new(292.0577087402344, 358.9395446777344, 479.53717041015625, -0.9031487703323364, -0.17063625156879425, -0.3939622640609741, 0.2961060404777527, -0.9120216369628906, -0.28379327058792114, -0.3108765482902527, -0.37296199798583984, 0.8742169141769409)
    
    local function createPart(name, size, color, meshType, meshScale)
        local part = Instance.new("Part")
        part.Name = name
        part.Size = size
        part.Color = color
        part.Material = Enum.Material.SmoothPlastic
        part.CanCollide = false
        part.Massless = true
        part.Anchored = false
        part.Parent = folder
        
        if meshType then
            local mesh = Instance.new("SpecialMesh")
            mesh.MeshType = meshType
            if meshScale then
                mesh.Scale = meshScale
            end
            mesh.Parent = part
        end
        
        return part
    end
    
    local function weldPart(part, worldCFrame)
        local relativeCFrame = getRelativeCFrame(worldCFrame)
        local weld = Instance.new("Weld")
        weld.Part0 = torso
        weld.Part1 = part
        local scaledPos = relativeCFrame.Position * Vector3.new(scaleX, scaleY, scaleZ)
        weld.C0 = CFrame.new(scaledPos) * relativeCFrame.Rotation
        weld.Parent = part
    end
    
    -- === BREASTS (using your skin color) ===
    local leftSkin = createPart("LeftBreast", Vector3.new(1.2598655223846436, 1.2590680122375488, 1.4745838642120361), skinColor, Enum.MeshType.Sphere, Vector3.new(1, 1, 1))
    local leftNipple = createPart("LeftNipple", Vector3.new(0.25253811478614807, 0.25253820419311523, 0.25253811478614807), Color3.fromRGB(255, 148, 148), Enum.MeshType.Sphere, Vector3.new(0.4946218430995941, 0.4946218430995941, 0.7066025733947754))
    local rightSkin = createPart("RightBreast", Vector3.new(1.2598655223846436, 1.2590680122375488, 1.4745838642120361), skinColor, Enum.MeshType.Sphere, Vector3.new(1, 1, 1))
    local rightNipple = createPart("RightNipple", Vector3.new(0.25253811478614807, 0.25253820419311523, 0.25253811478614807), Color3.fromRGB(255, 148, 148), Enum.MeshType.Sphere, Vector3.new(0.4946218430995941, 0.4946218430995941, 0.7066025733947754))
    
    weldPart(leftSkin, leftSkinWorld)
    weldPart(leftNipple, leftNippleWorld)
    weldPart(rightSkin, rightSkinWorld)
    weldPart(rightNipple, rightNippleWorld)
    
    print("[✓] Boba applied with skin color: " .. tostring(skinColor))
end

-- Apply on every respawn
player.CharacterAdded:Connect(function(char)
    task.wait(1.5)
    pcall(function() ApplyBoba() end)
end)

-- Apply on script run if character already exists
if player.Character then
    task.wait(2)
    pcall(function() ApplyBoba() end)
end
