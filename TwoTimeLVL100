-- ============================================
-- SHIFTLOCK BUTTON POSITIONING
-- ============================================

local function findButton()
    local function findGuiByPath(path)
        local parts = {}
        for part in string.gmatch(path, "[^%.]+") do
            table.insert(parts, part)
        end
        
        local current = playerGui
        for _, partName in ipairs(parts) do
            current = current and current:FindFirstChild(partName)
            if not current then
                return nil
            end
        end
        return current
    end
    
    local function findButtonByName(name)
        for _, descendant in ipairs(playerGui:GetDescendants()) do
            if descendant.Name == name and 
               (descendant:IsA("GuiButton") or descendant:IsA("TextButton") or descendant:IsA("ImageButton")) then
                return descendant
            end
        end
        return nil
    end
    
    local button = findGuiByPath(buttonPath)
    if not button then
        button = findButtonByName(buttonName)
    end
    
    return button
end

local function positionButton(button)
    if not button then
        button = findButton()
    end
    
    if button then
        button.Position = newPosition
        button.Size = newSize
        print("✅ ShiftLock button positioned!")
        return true
    end
    return false
end

local function setupButtonTracker(button)
    if not button then return end
    
    button:GetPropertyChangedSignal("Position"):Connect(function()
        local currentPos = button.Position
        if math.abs(currentPos.X.Offset - newPosition.X.Offset) > 0.1 or
           math.abs(currentPos.Y.Offset - newPosition.Y.Offset) > 0.1 or
           math.abs(currentPos.X.Scale - newPosition.X.Scale) > 0.001 or
           math.abs(currentPos.Y.Scale - newPosition.Y.Scale) > 0.001 then
            button.Position = newPosition
            print("🔄 ShiftLock repositioned (game tried to move it)")
        end
    end)
    
    button:GetPropertyChangedSignal("Size"):Connect(function()
        local currentSize = button.Size
        if math.abs(currentSize.X.Offset - newSize.X.Offset) > 0.1 or
           math.abs(currentSize.Y.Offset - newSize.Y.Offset) > 0.1 or
           math.abs(currentSize.X.Scale - newSize.X.Scale) > 0.001 or
           math.abs(currentSize.Y.Scale - newSize.Y.Scale) > 0.001 then
            button.Size = newSize
            print("🔄 ShiftLock resized (game tried to resize it)")
        end
    end)
end

-- Initial button positioning
task.spawn(function()
    task.wait(1)
    local button = findButton()
    if button then
        positionButton(button)
        setupButtonTracker(button)
        print("🔒 ShiftLock tracking active")
    else
