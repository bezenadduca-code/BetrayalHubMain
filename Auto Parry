local infStam = { enabled = false, thread = nil, origInit = nil, mod = nil }

local function getStamModule()
    if infStam.mod then return infStam.mod end
    local ok, m = pcall(function() return require(RS.Systems.Character.Game.Sprinting) end)
    if ok and m then infStam.mod = m; infStam.origInit = m.Init end
    return ok and m or nil
end

local function patchStamInit(m)
    if not m or not infStam.origInit then return end
    m.Init = function(...)
        local res = infStam.origInit(...)
        m.StaminaLossDisabled = true
        return res
    end
end

local function unpatchStamInit(m)
    if not m or not infStam.origInit then return end
    m.Init = infStam.origInit
end

local function applyInfStam()
    pcall(function()
        if not infStam.enabled then return end
        local m = getStamModule(); if not m then return end
        if not m.DefaultsSet then pcall(function() m.Init() end) end
        m.StaminaLossDisabled = true
        patchStamInit(m)
        pcall(function() if m.Stamina then m.Stamina = m.MaxStamina or 100 end end)
    end)
end

local function startInfStam()
    if infStam.thread then return end
    infStam.thread = task.spawn(function()
        while infStam.enabled do
            pcall(function()
                if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then applyInfStam() end
            end)
            task.wait(0.5)
        end
        infStam.thread = nil
    end)
end

local function stopInfStam()
    infStam.enabled = false
    if infStam.thread then task.cancel(infStam.thread); infStam.thread = nil end
    pcall(function()
        local m = getStamModule()
        if m then m.StaminaLossDisabled = false; unpatchStamInit(m) end
    end)
end

