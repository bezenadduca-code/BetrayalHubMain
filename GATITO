local function ensureFolder(parent, name)
    local f = parent:FindFirstChild(name)
    if not f then
        f = Instance.new("Folder")
        f.Name = name
        f.Parent = parent
    end
    return f
end

local function buildGatito()
    print("[GatitoBuilder] Building Gatito emote locally...")

    local assets       = ensureFolder(ReplicatedStorage, "Assets")
    local emotesFolder = ensureFolder(assets, "Emotes")

    local oldGatito = emotesFolder:FindFirstChild("Gatito")
    if oldGatito then oldGatito:Destroy() end

    -- ---- helpers ----
    local function makePart(props)
        local p = Instance.new("Part")
        p.Name          = props.Name or "Part"
        p.Size          = props.Size or Vector3.new(1, 1, 1)
        p.CFrame        = props.CFrame or CFrame.new()
        p.Anchored      = props.Anchored or false
        p.CanCollide    = props.CanCollide or false
        p.Massless      = props.Massless ~= false
        p.Transparency  = props.Transparency or 0
        p.Color         = props.Color or Color3.fromRGB(27, 42, 53)
        p.Material      = props.Material or Enum.Material.Plastic
        p.TopSurface    = props.TopSurface or Enum.SurfaceType.Smooth
        p.BottomSurface = props.BottomSurface or Enum.SurfaceType.Smooth
        return p
    end

    local function addMesh(part, props)
        local m = Instance.new("SpecialMesh")
        m.MeshType    = props.MeshType or Enum.MeshType.Head
        m.MeshId      = props.MeshId or ""
        m.TextureId   = props.TextureId or ""
        m.Scale       = props.Scale or Vector3.new(1, 1, 1)
        m.Offset      = props.Offset or Vector3.new(0, 0, 0)
        m.VertexColor = props.VertexColor or Vector3.new(1, 1, 1)
        m.Parent = part
        return m
    end

    local function addMotor(part, props)
        local m = Instance.new("Motor6D")
        m.Name   = props.Name or "Motor"
        m.Part0  = props.Part0
        m.Part1  = props.Part1
        m.C0     = props.C0 or CFrame.new()
        m.C1     = props.C1 or CFrame.new()
        m.Parent = part
        return m
    end

